              "raw": "{{restaurantServiceUrl}}/api/restaurants/{{restaurantId}}",
              "host": ["{{restaurantServiceUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Create Restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('restaurantId', res.id);",
                  "    pm.environment.set('restaurantId', res.id);",
                  "}",
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{ownerId}}" },
              { "key": "X-User-Role", "value": "RESTAURANT_OWNER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Com Tam Suon Nuong\",\n  \"description\": \"Quan com tam ngon o Q1\",\n  \"address\": \"123 Nguyen Trai, Q1, TP.HCM\",\n  \"phone\": \"0901234567\",\n  \"cuisineType\": \"VIETNAMESE\",\n  \"imageUrl\": \"https://example.com/restaurant.jpg\",\n  \"operatingHours\": [\n    { \"dayOfWeek\": \"MONDAY\", \"openTime\": \"08:00\", \"closeTime\": \"21:00\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{restaurantServiceUrl}}/api/restaurants",
              "host": ["{{restaurantServiceUrl}}"],
              "path": ["api", "restaurants"]
            }
          },
          "response": []
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{ownerId}}" },
              { "key": "X-User-Role", "value": "RESTAURANT_OWNER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Com Tam Suon Nuong (Updated)\",\n  \"description\": \"Quan com tam ngon o Q1 - da cap nhat\",\n  \"address\": \"123 Nguyen Trai, Q1, TP.HCM\",\n  \"phone\": \"0901234567\",\n  \"cuisineType\": \"VIETNAMESE\",\n  \"imageUrl\": \"https://example.com/restaurant.jpg\",\n  \"operatingHours\": [\n    { \"dayOfWeek\": \"MONDAY\", \"openTime\": \"08:00\", \"closeTime\": \"22:00\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{restaurantServiceUrl}}/api/restaurants/{{restaurantId}}",
              "host": ["{{restaurantServiceUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Restaurant",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{ownerId}}" },
              { "key": "X-User-Role", "value": "RESTAURANT_OWNER" }
            ],
            "url": {
              "raw": "{{restaurantServiceUrl}}/api/restaurants/{{restaurantId}}",
              "host": ["{{restaurantServiceUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}"]
            }
          },
          "response": []
        }
