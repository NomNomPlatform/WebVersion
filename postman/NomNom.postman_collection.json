{
  "info": {
    "name": "NomNom Food Ordering Platform",
    "description": "API test collection cho NomNom. Auth (register/login) va cac request goi qua gateway ({{gatewayUrl}}) dung {{accessToken}}. Cac service con lai hien chua co JWT filter rieng nen duoc goi truc tiep toi tung service (vd {{restaurantServiceUrl}}) va tu set header X-User-Id / X-User-Role (binh thuong do API Gateway inject sau khi validate JWT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "userServiceUrl", "value": "http://localhost:8081" },
    { "key": "restaurantServiceUrl", "value": "http://localhost:8082" },
    { "key": "orderServiceUrl", "value": "http://localhost:8083" },
    { "key": "menuServiceUrl", "value": "http://localhost:8084" },
    { "key": "paymentServiceUrl", "value": "http://localhost:8085" },
    { "key": "recommendationServiceUrl", "value": "http://localhost:8086" },
    { "key": "notificationServiceUrl", "value": "http://localhost:8087" },
    { "key": "accessToken", "value": "" },
    { "key": "ownerAccessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "ownerId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "menuItemId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" }
  ],
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Register Customer",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer1@nomnom.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Nguyen Van A\",\n  \"role\": \"CUSTOMER\"\n}"
                },
                "url": {
                  "raw": "{{userServiceUrl}}/api/auth/register",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "auth", "register"]
                }
              },
              "response": []
            },
            {
              "name": "Register Restaurant Owner",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"owner1@nomnom.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Tran Thi B\",\n  \"role\": \"RESTAURANT_OWNER\"\n}"
                },
                "url": {
                  "raw": "{{userServiceUrl}}/api/auth/register",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "auth", "register"]
                }
              },
              "response": []
            },
            {
              "name": "Login Customer",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) {",
                      "    pm.collectionVariables.set('accessToken', res.token);",
                      "    pm.environment.set('accessToken', res.token);",
                      "}",
                      "if (res.userId) {",
                      "    pm.collectionVariables.set('userId', res.userId);",
                      "    pm.environment.set('userId', res.userId);",
                      "}",
                      "pm.test('Status is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"customer1@nomnom.com\",\n  \"password\": \"Password123!\"\n}"
                },
                "url": {
                  "raw": "{{userServiceUrl}}/api/auth/login",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "auth", "login"]
                }
              },
              "response": []
            },
            {
              "name": "Login Restaurant Owner",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) {",
                      "    pm.collectionVariables.set('ownerAccessToken', res.token);",
                      "    pm.environment.set('ownerAccessToken', res.token);",
                      "}",
                      "if (res.userId) {",
                      "    pm.collectionVariables.set('ownerId', res.userId);",
                      "    pm.environment.set('ownerId', res.userId);",
                      "}",
                      "pm.test('Status is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"owner1@nomnom.com\",\n  \"password\": \"Password123!\"\n}"
                },
                "url": {
                  "raw": "{{userServiceUrl}}/api/auth/login",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "auth", "login"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Users",
          "item": [
            {
              "name": "Get My Profile",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{userServiceUrl}}/api/users/me",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "users", "me"]
                }
              },
              "response": []
            },
            {
              "name": "Update My Profile",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"height\": 175.0,\n  \"weight\": 68.5,\n  \"age\": 28,\n  \"gender\": \"MALE\",\n  \"activityLevel\": \"MODERATE\"\n}"
                },
                "url": {
                  "raw": "{{userServiceUrl}}/api/users/me",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "users", "me"]
                }
              },
              "response": []
            },
            {
              "name": "Get My Health Metrics",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{userServiceUrl}}/api/users/me/health",
                  "host": ["{{userServiceUrl}}"],
                  "path": ["api", "users", "me", "health"]
                }
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Restaurant Service",
