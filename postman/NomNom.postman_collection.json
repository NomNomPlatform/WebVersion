          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{restaurantServiceUrl}}/api/restaurants?page=0&size=10",
              "host": ["{{restaurantServiceUrl}}"],
              "path": ["api", "restaurants"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Restaurant By Id",
          "request": {
            "method": "GET",
            "header": [],
