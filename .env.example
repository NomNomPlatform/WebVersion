# Template biến môi trường — copy sang .env.local và điền giá trị thật.
# KHÔNG commit .env.local (đã có trong .gitignore).

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT — phải đủ >= 32 ký tự (HS256). Giống nhau giữa user-service và api-gateway.
JWT_SECRET=nomnom_super_secret_change_in_production_min_32_chars
JWT_EXPIRATION=86400000

# Google OAuth 2.0 (đăng nhập bằng Google trên web app).
# Tạo tại https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, loại Web application).
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: KHÔNG cần vì ta dùng Google Identity Services (id_token).
GOOGLE_CLIENT_ID=

# Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka

# AI API keys (cho recommendation-service) — KHÔNG commit giá trị thật
GROQ_API_KEY=
GEMINI_API_KEY=

# ===== Frontend (Vite build-time) =====
# Google OAuth 2.0 Client ID dùng cho Google Identity Services trên web-app.
# Phải đăng ký Authorized JavaScript origin = http://localhost:5173 (và domain prod).
# Backend verify id_token bằng GOOGLE_CLIENT_ID tương ứng — HAI giá trị phải khớp client_id.
VITE_GOOGLE_CLIENT_ID=

#SandBox VNPAY
#Số thẻ: 9704198526131432111, Tên chủ thẻ: NGUYEN VAN A, Ngày phát hành: 07/15, OTP: 123456
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
